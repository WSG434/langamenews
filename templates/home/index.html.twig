{% extends 'base.html.twig' %}

{% block title %}LanGame News{% endblock %}

{% block stylesheets %}
<style>
    .home-hero {
        max-width: 560px;
        margin: 5rem auto;
        text-align: center;
    }
    .home-hero img { height: 48px; margin-bottom: 2rem; }
    .home-hero h1 { font-size: 2rem; color: #fff; margin: 0 0 0.75rem; }
    .home-hero p { color: #888; margin: 0 0 2rem; font-size: 1rem; }
    .home-hero .actions { display: flex; gap: 1rem; justify-content: center; }
    .btn { padding: 0.6rem 1.5rem; border-radius: 3px; font-size: 0.95rem; text-decoration: none; }
    .btn-red { background: #DC0000; color: #fff; }
    .btn-red:hover { background: #b00000; }
    .btn-outline { background: transparent; border: 1px solid #444; color: #ccc; }
    .btn-outline:hover { border-color: #DC0000; color: #DC0000; }
</style>
{% endblock %}

{% block body %}
<div class="home-hero">
    <img src="{{ asset('images/logo.svg') }}" alt="LanGame">
    <h1>Новостной агрегатор</h1>
    <p>Следите за актуальными новостями в режиме реального времени</p>
    <div class="actions">
        <a href="{{ path('app_register') }}" class="btn btn-red">Зарегистрироваться</a>
        <a href="{{ path('app_login') }}" class="btn btn-outline">Войти</a>
    </div>
</div>
{% endblock %}

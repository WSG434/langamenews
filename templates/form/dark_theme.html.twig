{% use 'form_div_layout.html.twig' %}

{% block form_widget_simple %}
{% set attr = attr|merge({style: 'width:100%;padding:0.65rem 0.85rem;background:#111;border:1px solid #2e2e2e;border-radius:3px;color:#e0e0e0;font-size:0.95rem;outline:none;box-sizing:border-box;'}) %}
{{ parent() }}
{% endblock %}

{% block form_label %}
{% set label_attr = label_attr|merge({style: 'display:block;margin-bottom:0.35rem;font-size:0.82rem;color:#888;text-transform:uppercase;letter-spacing:0.05em;'}) %}
{{ parent() }}
{% endblock %}

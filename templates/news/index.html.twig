{% extends 'base.html.twig' %}

{% block title %}News — News Aggregator{% endblock %}

{% block stylesheets %}
<style>
    .page-container { max-width: 860px; margin: 0 auto; }

    .page-container h1 { font-size: 1.3rem; color: #fff; margin: 0 0 1.25rem; }

    .source-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.75rem; }
    .chip {
        display: inline-flex; align-items: center; gap: 0.3rem;
        padding: 0.25rem 0.7rem; border-radius: 999px; font-size: 0.8rem;
        cursor: pointer; border: 1px solid #333; background: #1a1a1a;
        color: #888; transition: background 0.15s, color 0.15s, border-color 0.15s;
        user-select: none;
    }
    .chip.active { background: #DC0000; color: #fff; border-color: #DC0000; }
    .chip.loading { opacity: 0.5; pointer-events: none; }

    .search-box { margin-bottom: 1.5rem; }
    .search-box input {
        width: 100%;
        padding: 0.6rem 0.9rem;
        font-size: 1rem;
        background: #1a1a1a;
        border: 1px solid #333;
        border-radius: 4px;
        color: #e0e0e0;
        box-sizing: border-box;
        outline: none;
    }
    .search-box input:focus { border-color: #DC0000; }
    .search-box input::placeholder { color: #555; }

    .news-list { list-style: none; padding: 0; margin: 0; }

    .news-item {
        display: flex;
        gap: 1rem;
        padding: 1rem 0;
        border-bottom: 1px solid #222;
        align-items: flex-start;
    }
    .news-item:last-child { border-bottom: none; }

    .news-item__img {
        flex-shrink: 0;
        width: 120px;
        height: 80px;
        object-fit: cover;
        border-radius: 3px;
        background: #222;
    }

    .news-item__body { flex: 1; min-width: 0; }

    .news-item__title {
        margin: 0 0 0.3rem;
        font-size: 0.97rem;
        line-height: 1.4;
    }
    .news-item__title a { color: #e0e0e0; text-decoration: none; }
    .news-item__title a:hover { color: #DC0000; }
    .news-item__title a:visited { color: #aaa; }

    .news-item__summary {
        margin: 0 0 0.4rem;
        color: #777;
        font-size: 0.85rem;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .news-item__meta { font-size: 0.76rem; color: #555; }
    .news-item__source {
        display: inline-block;
        background: #222;
        border-radius: 3px;
        padding: 1px 6px;
        margin-right: 5px;
        color: #888;
        font-weight: 500;
    }

    mark { background: #5a1a00; color: #ffaa80; padding: 0 1px; border-radius: 2px; }
    #scroll-sentinel { height: 1px; }
    #loading-indicator { text-align: center; padding: 1rem 0; color: #555; font-size: 0.85rem; display: none; }
    #results-empty { color: #555; padding: 1rem 0; }
</style>
{% endblock %}

{% block body %}
<div class="page-container">
    <h1>Последние новости</h1>

    <div class="source-chips" id="source-chips" data-csrf="{{ csrf_token('toggle_source') }}">
        {% for source in sources %}
            <span class="chip {% if source.code not in disabledSourceCodes %}active{% endif %}"
                  data-code="{{ source.code }}"
                  data-id="{{ source.id }}"
                  title="{{ source.type }}">{{ source.name }}</span>
        {% endfor %}
    </div>

    <div class="search-box">
        <input type="text" id="q" placeholder="Поиск новостей…" autocomplete="off">
    </div>

    <ul class="news-list" id="news-list">
        {% for item in news %}
        <li class="news-item" data-source="{{ item.source }}">
            {% if item.imageUrl %}
                <img class="news-item__img" src="{{ item.imageUrl }}" alt="">
            {% endif %}
            <div class="news-item__body">
                <h3 class="news-item__title">
                    {% if item.url %}
                        <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
                    {% else %}
                        {{ item.title }}
                    {% endif %}
                </h3>
                {% if item.summary %}
                    <p class="news-item__summary">{{ item.summary|striptags }}</p>
                {% endif %}
                <div class="news-item__meta">
                    <span class="news-item__source">{{ item.source }}</span>
                    {{ item.publishedAt ? item.publishedAt|date('d.m.Y H:i') : '—' }}
                </div>
            </div>
        </li>
        {% else %}
        <li id="results-empty">Новостей пока нет.</li>
        {% endfor %}
    </ul>

    <div id="loading-indicator">Загрузка…</div>
    <div id="scroll-sentinel"></div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var input = document.getElementById('q');
    var list = document.getElementById('news-list');
    var chipsEl = document.getElementById('source-chips');
    var sentinel = document.getElementById('scroll-sentinel');
    var loader = document.getElementById('loading-indicator');
    var csrfToken = chipsEl ? chipsEl.dataset.csrf : '';
    var timer = null;
    var offset = {{ news|length }};
    var loading = false;
    var exhausted = false;
    var searching = false;

    function makeItem(n) {
        var li = document.createElement('li');
        li.className = 'news-item';
        li.dataset.source = n.source || '';

        if (n.imageUrl) {
            var img = document.createElement('img');
            img.className = 'news-item__img';
            img.src = n.imageUrl;
            img.alt = '';
            img.loading = 'lazy';
            li.appendChild(img);
        }

        var body = document.createElement('div');
        body.className = 'news-item__body';

        var h3 = document.createElement('h3');
        h3.className = 'news-item__title';
        if (n.url) {
            var a = document.createElement('a');
            a.href = n.url;
            a.target = '_blank';
            a.rel = 'noopener';
            a.textContent = n.title || '';
            h3.appendChild(a);
        } else {
            h3.textContent = n.title || '';
        }
        body.appendChild(h3);

        if (n.summary) {
            var p = document.createElement('p');
            p.className = 'news-item__summary';
            p.textContent = n.summary;
            body.appendChild(p);
        }

        var meta = document.createElement('div');
        meta.className = 'news-item__meta';
        var sourceSpan = document.createElement('span');
        sourceSpan.className = 'news-item__source';
        sourceSpan.textContent = n.source || '';
        meta.appendChild(sourceSpan);
        meta.appendChild(document.createTextNode(' ' + (n.publishedAt || '—')));
        body.appendChild(meta);

        li.appendChild(body);
        return li;
    }

    function appendItems(items) {
        items.forEach(function (n) { list.appendChild(makeItem(n)); });
    }

    function replaceItems(items) {
        list.innerHTML = '';
        if (items.length === 0) {
            list.innerHTML = '<li id="results-empty">Ничего не найдено.</li>';
        } else {
            appendItems(items);
        }
    }

    function refreshList() {
        var q = input.value.trim();
        searching = q !== '';
        fetch('/news/search?q=' + encodeURIComponent(q))
            .then(function (r) { return r.json(); })
            .then(function (items) {
                replaceItems(items);
                offset = searching ? 0 : items.length;
                exhausted = searching;
            });
    }
    window.newsRefreshList = refreshList;

    function loadMore() {
        if (loading || exhausted || searching) return;
        loading = true;
        loader.style.display = 'block';
        fetch('/news/more?offset=' + offset)
            .then(function (r) { return r.json(); })
            .then(function (items) {
                appendItems(items);
                offset += items.length;
                if (items.length < 20) exhausted = true;
                loading = false;
                loader.style.display = 'none';
            });
    }

    var observer = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) loadMore();
    }, { rootMargin: '300px' });
    observer.observe(sentinel);

    input.addEventListener('input', function () {
        clearTimeout(timer);
        timer = setTimeout(refreshList, 300);
    });

    // Source chips
    document.querySelectorAll('#source-chips .chip').forEach(function (chip) {
        chip.addEventListener('click', function () {
            chip.classList.add('loading');
            fetch('/news/sources/' + chip.dataset.id + '/toggle', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-Token': csrfToken }
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                chip.classList.toggle('active', data.enabled);
                chip.classList.remove('loading');
                refreshList();
                offset = 0;
                exhausted = false;
            })
            .catch(function () { chip.classList.remove('loading'); });
        });
    });
}());
</script>
{% endblock %}

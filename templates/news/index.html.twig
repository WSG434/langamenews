{% extends 'base.html.twig' %}

{% block title %}News — News Aggregator{% endblock %}

{% block stylesheets %}
<style>
    .page-container { max-width: 860px; margin: 0 auto; }

    .search-box { margin-bottom: 1.5rem; }
    .search-box input {
        width: 100%;
        padding: 0.6rem 0.9rem;
        font-size: 1rem;
        border: 1px solid #ccc;
        border-radius: 6px;
        box-sizing: border-box;
        outline: none;
    }
    .search-box input:focus { border-color: #555; }

    .news-list { list-style: none; padding: 0; margin: 0; }

    .news-item {
        display: flex;
        gap: 1rem;
        padding: 1rem 0;
        border-bottom: 1px solid #eee;
        align-items: flex-start;
    }
    .news-item:last-child { border-bottom: none; }

    .news-item__img {
        flex-shrink: 0;
        width: 120px;
        height: 80px;
        object-fit: cover;
        border-radius: 4px;
        background: #f0f0f0;
    }

    .news-item__body { flex: 1; min-width: 0; }

    .news-item__title {
        margin: 0 0 0.3rem;
        font-size: 0.97rem;
        line-height: 1.4;
    }
    .news-item__title a { color: #1a1a1a; text-decoration: none; }
    .news-item__title a:hover { text-decoration: underline; color: #0066cc; }
    .news-item__title a:visited { color: #551a8b; }

    .news-item__summary {
        margin: 0 0 0.4rem;
        color: #555;
        font-size: 0.85rem;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .news-item__meta { font-size: 0.76rem; color: #999; }
    .news-item__source {
        display: inline-block;
        background: #f0f0f0;
        border-radius: 3px;
        padding: 1px 6px;
        margin-right: 5px;
        color: #555;
        font-weight: 500;
    }

    mark { background: #fff3cd; padding: 0 1px; border-radius: 2px; }
    #scroll-sentinel { height: 1px; }
    #loading-indicator { text-align: center; padding: 1rem 0; color: #aaa; font-size: 0.9rem; display: none; }
    #results-empty { color: #888; padding: 1rem 0; }
</style>
{% endblock %}

{% block body %}
<div class="page-container">
    <h1>Latest News</h1>

    <div class="search-box">
        <input type="text" id="q" placeholder="Search news…" autocomplete="off">
    </div>

    <ul class="news-list" id="news-list">
        {% for item in news %}
        <li class="news-item">
            {% if item.imageUrl %}
                <img class="news-item__img" src="{{ item.imageUrl }}" alt="">
            {% endif %}
            <div class="news-item__body">
                <h3 class="news-item__title">
                    {% if item.url %}
                        <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
                    {% else %}
                        {{ item.title }}
                    {% endif %}
                </h3>
                {% if item.summary %}
                    <p class="news-item__summary">{{ item.summary|striptags }}</p>
                {% endif %}
                <div class="news-item__meta">
                    <span class="news-item__source">{{ item.source }}</span>
                    {{ item.publishedAt ? item.publishedAt|date('d.m.Y H:i') : '—' }}
                </div>
            </div>
        </li>
        {% else %}
        <li id="results-empty">No news yet. Run <code>php bin/console app:news:import</code>.</li>
        {% endfor %}
    </ul>

    <div id="loading-indicator">Loading…</div>
    <div id="scroll-sentinel"></div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var input = document.getElementById('q');
    var list = document.getElementById('news-list');
    var sentinel = document.getElementById('scroll-sentinel');
    var loader = document.getElementById('loading-indicator');
    var timer = null;
    var offset = {{ news|length }};
    var loading = false;
    var exhausted = false;
    var searching = false;

    function makeItem(n) {
        var li = document.createElement('li');
        li.className = 'news-item';
        var img = n.imageUrl
            ? '<img class="news-item__img" src="' + n.imageUrl + '" alt="" loading="lazy">'
            : '';
        var titleHtml = n.url
            ? '<a href="' + n.url + '" target="_blank" rel="noopener">' + n.title + '</a>'
            : n.title;
        var summary = n.summary
            ? '<p class="news-item__summary">' + n.summary + '</p>'
            : '';
        li.innerHTML = img
            + '<div class="news-item__body">'
            + '<h3 class="news-item__title">' + titleHtml + '</h3>'
            + summary
            + '<div class="news-item__meta"><span class="news-item__source">' + n.source + '</span>'
            + (n.publishedAt || '—') + '</div>'
            + '</div>';
        return li;
    }

    function appendItems(items) {
        items.forEach(function (n) { list.appendChild(makeItem(n)); });
    }

    function replaceItems(items) {
        list.innerHTML = '';
        if (items.length === 0) {
            list.innerHTML = '<li id="results-empty">No results found.</li>';
        } else {
            appendItems(items);
        }
    }

    function loadMore() {
        if (loading || exhausted || searching) return;
        loading = true;
        loader.style.display = 'block';
        fetch('/news/more?offset=' + offset)
            .then(function (r) { return r.json(); })
            .then(function (items) {
                appendItems(items);
                offset += items.length;
                if (items.length < 20) exhausted = true;
                loading = false;
                loader.style.display = 'none';
            });
    }

    var observer = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) loadMore();
    }, { rootMargin: '300px' });
    observer.observe(sentinel);

    input.addEventListener('input', function () {
        clearTimeout(timer);
        timer = setTimeout(function () {
            var q = input.value.trim();
            searching = q !== '';
            fetch('/news/search?q=' + encodeURIComponent(q))
                .then(function (r) { return r.json(); })
                .then(function (items) {
                    replaceItems(items);
                    if (!searching) {
                        offset = items.length;
                        exhausted = false;
                    }
                });
        }, 300);
    });
}());
</script>
{% endblock %}

<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}News Aggregator{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <style>
            body { font-family: sans-serif; margin: 0; padding: 0; }
            nav { background: #333; color: #fff; padding: 0.75rem 1.5rem; display: flex; align-items: center; gap: 1rem; }
            nav a { color: #fff; text-decoration: none; }
            nav a:hover { text-decoration: underline; }
            nav .spacer { flex: 1; }
            main { padding: 2rem 1.5rem; }
            .flash { padding: 0.75rem 1rem; margin-bottom: 1rem; border-radius: 4px; }
            .flash-success { background: #d4edda; color: #155724; }
            .flash-error { background: #f8d7da; color: #721c24; }
            .flash-info { background: #d1ecf1; color: #0c5460; }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <nav>
            <a href="{{ path('app_home') }}"><strong>News Aggregator</strong></a>
            <span class="spacer"></span>
            {% if app.user %}
                <span>{{ app.user.userIdentifier }}</span>
                <a href="{{ path('app_news') }}">News</a>
                <a href="{{ path('app_news_sources') }}">Sources</a>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin') }}">Admin</a>
                {% endif %}
                <a href="{{ path('app_logout') }}">Logout</a>
            {% else %}
                <a href="{{ path('app_login') }}">Login</a>
                <a href="{{ path('app_register') }}">Register</a>
            {% endif %}
        </nav>
        <main>
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ type }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
        {% block javascripts %}{% endblock %}
        {% include '_notifications.html.twig' %}
    </body>
</html>

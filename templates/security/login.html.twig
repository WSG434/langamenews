{% extends 'base.html.twig' %}

{% block title %}Вход — LanGame News{% endblock %}

{% block stylesheets %}
<style>
    .auth-page {
        min-height: calc(100vh - 56px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }
    .auth-box {
        width: 100%;
        max-width: 400px;
        background: #1a1a1a;
        border: 1px solid #2a2a2a;
        border-top: 3px solid #DC0000;
        border-radius: 4px;
        padding: 2.5rem 2rem;
    }
    .auth-logo {
        display: block;
        text-align: center;
        margin-bottom: 2rem;
    }
    .auth-logo img { height: 32px; filter: brightness(0) invert(1); }
    .auth-box h1 {
        text-align: center;
        font-size: 1.1rem;
        color: #888;
        font-weight: 400;
        margin: 0 0 1.75rem;
        letter-spacing: 0.03em;
    }
    .form-group { margin-bottom: 1.1rem; }
    .form-group label { display: block; margin-bottom: 0.35rem; font-size: 0.82rem; color: #888; text-transform: uppercase; letter-spacing: 0.05em; }
    .form-group input {
        width: 100%; padding: 0.65rem 0.85rem;
        background: #111; border: 1px solid #2e2e2e; border-radius: 3px;
        color: #e0e0e0; font-size: 0.95rem; outline: none; box-sizing: border-box;
        transition: border-color 0.15s;
    }
    .form-group input:focus { border-color: #DC0000; }
    .btn-submit {
        width: 100%; padding: 0.7rem;
        background: #DC0000; color: #fff; border: none;
        border-radius: 3px; font-size: 0.95rem; cursor: pointer;
        margin-top: 0.5rem; letter-spacing: 0.03em;
        transition: background 0.15s;
    }
    .btn-submit:hover { background: #b00000; }
    .auth-foot { margin-top: 1.5rem; text-align: center; font-size: 0.85rem; color: #666; }
    .auth-foot a { color: #DC0000; text-decoration: none; }
    .auth-foot a:hover { text-decoration: underline; }
</style>
{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="auth-box">
        <a href="{{ path('app_home') }}" class="auth-logo">
            <img src="{{ asset('images/logo.svg') }}" alt="LanGame">
        </a>
        <h1>Войдите в аккаунт</h1>

        {% if error %}
            <div class="flash flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <div class="form-group">
                <label for="email">Email</label>
                <input id="email" type="email" name="_username" value="{{ last_username }}" required autofocus>
            </div>
            <div class="form-group">
                <label for="password">Пароль</label>
                <input id="password" type="password" name="_password" required>
            </div>
            <button type="submit" class="btn-submit">Войти</button>
        </form>

        <div class="auth-foot">
            Нет аккаунта? <a href="{{ path('app_register') }}">Зарегистрироваться</a>
        </div>
    </div>
</div>
{% endblock %}

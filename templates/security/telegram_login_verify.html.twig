{% extends 'base.html.twig' %}

{% block title %}Введите код — LanGame News{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="auth-box">
        <a href="{{ path('app_home') }}" class="auth-logo">
            <img src="{{ asset('images/logo.svg') }}" alt="LanGame">
        </a>
        <h1>Введите код</h1>

        {% for msg in app.flashes('error') %}
            <div class="flash flash-error">{{ msg }}</div>
        {% endfor %}

        <p style="color:#888;font-size:0.9rem;margin:0 0 1.25rem;">Проверьте Telegram — бот прислал вам код.</p>

        <form method="post">
            <div class="form-group">
                <label for="code">Код</label>
                <input id="code" type="text" name="code" maxlength="6"
                       inputmode="numeric" pattern="\d{6}" autofocus required
                       style="letter-spacing:0.3em;text-align:center;font-size:1.4rem;">
            </div>
            <button type="submit" class="btn-submit">Войти</button>
        </form>

        <div class="auth-foot">
            <a href="{{ path('app_telegram_login') }}">← Запросить новый код</a>
        </div>
    </div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Вход через Telegram — LanGame News{% endblock %}

{% block stylesheets %}
<style>
    .auth-wrap {
        max-width: 420px;
        margin: 3rem auto;
        background: #1a1a1a;
        border: 1px solid #2a2a2a;
        border-top: 3px solid #DC0000;
        border-radius: 4px;
        padding: 2rem;
    }
    .auth-wrap h1 { margin: 0 0 0.5rem; font-size: 1.4rem; color: #fff; }
    .auth-wrap p { color: #888; font-size: 0.9rem; margin: 0 0 1.5rem; }
    .form-group { margin-bottom: 1.1rem; }
    .form-group label { display: block; margin-bottom: 0.35rem; font-size: 0.85rem; color: #aaa; }
    .form-group input {
        width: 100%; padding: 0.6rem 0.75rem;
        background: #111; border: 1px solid #333; border-radius: 3px;
        color: #e0e0e0; font-size: 1.4rem; letter-spacing: 0.3em;
        text-align: center; outline: none; box-sizing: border-box;
    }
    .form-group input:focus { border-color: #DC0000; }
    .btn-submit {
        width: 100%; padding: 0.65rem;
        background: #DC0000; color: #fff; border: none;
        border-radius: 3px; font-size: 1rem; cursor: pointer;
    }
    .btn-submit:hover { background: #b00000; }
    .tg-hint { margin: 0 0 1.5rem; padding: 1rem; background: #0d1f2d; border: 1px solid #1a4a6e; border-radius: 4px; }
    .tg-hint p { margin: 0 0 0.75rem; color: #90caf9; font-size: 0.88rem; }
    .btn-tg { display: block; text-align: center; padding: 0.55rem; background: #0088cc; color: #fff; border-radius: 3px; text-decoration: none; font-size: 0.9rem; }
    .btn-tg:hover { background: #006ea6; }
    .auth-back { margin-top: 1.25rem; text-align: center; font-size: 0.85rem; }
    .auth-back a { color: #555; text-decoration: none; }
    .auth-back a:hover { color: #aaa; }
</style>
{% endblock %}

{% block body %}
<div class="auth-wrap">
    <h1>Вход через Telegram</h1>
    <p>Нажмите кнопку ниже, откройте бота и нажмите <strong style="color:#90caf9;">Start</strong> — он пришлёт вам код.</p>

    {% for msg in app.flashes('error') %}
        <div class="flash flash-error">{{ msg }}</div>
    {% endfor %}

    <div class="tg-hint">
        <p>Нажмите кнопку ниже и нажмите Start в боте.</p>
        <a href="https://t.me/{{ botName }}?start=login" target="_blank" class="btn-tg">Открыть Telegram-бота</a>
    </div>

    <form method="post">
        <div class="form-group">
            <label for="code">Код из Telegram</label>
            <input type="text" id="code" name="code" maxlength="6"
                   inputmode="numeric" pattern="\d{6}" autofocus required>
        </div>
        <button type="submit" class="btn-submit">Войти</button>
    </form>

    <div class="auth-back">
        <a href="{{ path('app_login') }}">← Обычный вход</a>
    </div>
</div>
{% endblock %}

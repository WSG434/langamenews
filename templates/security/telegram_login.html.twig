{% extends 'base.html.twig' %}

{% block title %}Вход через Telegram — LanGame News{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="auth-box">
        <a href="{{ path('app_home') }}" class="auth-logo">
            <img src="{{ asset('images/logo.svg') }}" alt="LanGame">
        </a>
        <h1>Вход через Telegram</h1>

        {% for msg in app.flashes('error') %}
            <div class="flash flash-error">{{ msg }}</div>
        {% endfor %}

        <div class="tg-hint" style="margin:0 0 1.5rem;padding:1rem;background:#0d1f2d;border:1px solid #1a4a6e;border-radius:4px;">
            <p style="margin:0 0 0.75rem;color:#90caf9;font-size:0.88rem;">Откройте бота и введите <strong>/login</strong> — он пришлёт код.</p>
            <a href="https://t.me/{{ botName }}" target="_blank"
               style="display:block;text-align:center;padding:0.55rem;background:#0088cc;color:#fff;border-radius:3px;text-decoration:none;font-size:0.9rem;">
                Открыть Telegram-бота
            </a>
        </div>

        <form method="post">
            <div class="form-group">
                <label for="code">Код из Telegram</label>
                <input id="code" type="text" name="code" maxlength="6"
                       inputmode="numeric" pattern="\d{6}" autofocus required
                       style="letter-spacing:0.3em;text-align:center;font-size:1.4rem;">
            </div>
            <button type="submit" class="btn-submit">Войти</button>
        </form>

        <div class="auth-foot">
            <a href="{{ path('app_login') }}">← Обычный вход</a>
        </div>
    </div>
</div>
{% endblock %}

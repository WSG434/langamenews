{% extends 'base.html.twig' %}

{% block title %}Подтверждение — LanGame News{% endblock %}

{% block stylesheets %}
<style>
    .auth-wrap {
        max-width: 420px;
        margin: 3rem auto;
        background: #1a1a1a;
        border: 1px solid #2a2a2a;
        border-top: 3px solid #DC0000;
        border-radius: 4px;
        padding: 2rem;
    }
    .auth-wrap h1 { margin: 0 0 0.5rem; font-size: 1.4rem; color: #fff; }
    .auth-wrap p { color: #888; font-size: 0.9rem; margin: 0 0 1.5rem; }
    .form-group { margin-bottom: 1.1rem; }
    .form-group label { display: block; margin-bottom: 0.35rem; font-size: 0.85rem; color: #aaa; }
    .form-group input {
        width: 100%; padding: 0.6rem 0.75rem;
        background: #111; border: 1px solid #333; border-radius: 3px;
        color: #e0e0e0; font-size: 1.4rem; letter-spacing: 0.3em;
        text-align: center; outline: none; box-sizing: border-box;
    }
    .form-group input:focus { border-color: #DC0000; }
    .btn-submit {
        width: 100%; padding: 0.65rem;
        background: #DC0000; color: #fff; border: none;
        border-radius: 3px; font-size: 1rem; cursor: pointer;
    }
    .btn-submit:hover { background: #b00000; }
    .btn-resend {
        width: 100%; padding: 0.55rem;
        background: transparent; color: #888; border: 1px solid #333;
        border-radius: 3px; font-size: 0.9rem; cursor: pointer; margin-top: 0.75rem;
    }
    .btn-resend:hover { border-color: #555; color: #ccc; }
    .tg-hint { margin: 1.25rem 0 1.5rem; padding: 1rem; background: #0d1f2d; border: 1px solid #1a4a6e; border-radius: 4px; }
    .tg-hint p { margin: 0 0 0.75rem; color: #90caf9; font-size: 0.88rem; }
    .btn-tg { display: block; text-align: center; padding: 0.55rem; background: #0088cc; color: #fff; border-radius: 3px; text-decoration: none; font-size: 0.9rem; }
    .btn-tg:hover { background: #006ea6; }
</style>
{% endblock %}

{% block body %}
<div class="auth-wrap">
    <h1>Подтверждение аккаунта</h1>
    {% if not telegramLinked %}
        <p>Откройте нашего Telegram-бота — он пришлёт вам код подтверждения.</p>
        {% if telegramLinkUrl %}
        <div class="tg-hint">
            <p>Нажмите кнопку ниже, откроется бот — нажмите Start и получите код.</p>
            <a href="{{ telegramLinkUrl }}" target="_blank" class="btn-tg">Открыть Telegram-бота</a>
        </div>
        {% endif %}
    {% else %}
        <p>Код отправлен в Telegram. Введите его ниже.</p>
    {% endif %}

    <form method="post" action="{{ path('app_confirm', {id: userId}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('confirm_' ~ userId) }}">
        <div class="form-group">
            <label for="code">Код подтверждения</label>
            <input type="text" id="code" name="code" maxlength="6"
                   inputmode="numeric" pattern="\d{6}" autofocus required>
        </div>
        <button type="submit" class="btn-submit">Подтвердить</button>
    </form>

    <form method="post" action="{{ path('app_confirm_resend', {id: userId}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('resend_' ~ userId) }}">
        <button type="submit" class="btn-resend">Отправить код повторно</button>
    </form>
</div>
{% endblock %}

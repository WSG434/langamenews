{% extends 'base.html.twig' %}

{% block title %}Settings — News Aggregator{% endblock %}

{% block body %}
<div style="max-width:500px;margin:0 auto">
    <h1>My Settings</h1>

    <form method="post" action="{{ path('app_settings') }}">
        <div style="padding:1rem;border:1px solid #ddd;border-radius:6px;margin-bottom:1.5rem">
            <strong>Telegram Notifications</strong>
            <p style="color:#666;font-size:0.9rem;margin:0.4rem 0 0.75rem">
                Controls whether your actions (login, registration) are announced in the Telegram channel.
                System events (news imports) are not affected by this setting.
            </p>
            <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer">
                <input type="checkbox" name="telegram_enabled" value="1"
                    {{ telegramEnabled ? 'checked' : '' }}
                    style="width:1.1rem;height:1.1rem">
                Send my events to Telegram
            </label>
        </div>

        <button type="submit" style="padding:0.5rem 1.2rem;background:#333;color:#fff;border:none;border-radius:4px;cursor:pointer">
            Save
        </button>
        <a href="{{ path('app_news') }}" style="margin-left:1rem;color:#555">← Back to news</a>
    </form>
</div>
{% endblock %}

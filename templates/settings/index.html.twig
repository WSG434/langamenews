{% extends 'base.html.twig' %}

{% block title %}Настройки — LanGame News{% endblock %}

{% block stylesheets %}
<style>
    .settings-wrap { max-width: 500px; margin: 0 auto; }
    .settings-wrap h1 { font-size: 1.3rem; color: #fff; margin: 0 0 1.5rem; }
    .settings-card {
        padding: 1.25rem;
        border: 1px solid #2a2a2a;
        border-radius: 4px;
        background: #1a1a1a;
        margin-bottom: 1.5rem;
    }
    .settings-card strong { color: #fff; font-size: 0.95rem; }
    .settings-card p { color: #666; font-size: 0.85rem; margin: 0.4rem 0 0.75rem; line-height: 1.5; }
    .settings-card label { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; color: #ccc; font-size: 0.9rem; }
    .settings-card input[type=checkbox] { width: 1.1rem; height: 1.1rem; accent-color: #DC0000; }
    .btn-save {
        padding: 0.55rem 1.4rem;
        background: #DC0000; color: #fff; border: none;
        border-radius: 3px; cursor: pointer; font-size: 0.95rem;
    }
    .btn-save:hover { background: #b00000; }
    .back-link { margin-left: 1rem; color: #666; text-decoration: none; font-size: 0.9rem; }
    .back-link:hover { color: #DC0000; }
    .tg-status { display: flex; align-items: center; gap: 0.75rem; margin-top: 0.75rem; }
    .tg-badge { font-size: 0.8rem; padding: 0.2rem 0.6rem; border-radius: 3px; }
    .tg-badge.linked { background: #1a3a1a; color: #4caf50; border: 1px solid #2e5e2e; }
    .tg-badge.unlinked { background: #3a1a1a; color: #e57373; border: 1px solid #5e2e2e; }
    .btn-tg { display: inline-block; padding: 0.45rem 1rem; background: #0088cc; color: #fff; border-radius: 3px; text-decoration: none; font-size: 0.88rem; }
    .btn-tg:hover { background: #006ea6; }
    .settings-input { width: 100%; padding: 0.5rem 0.75rem; background: #111; border: 1px solid #333; border-radius: 3px; color: #e0e0e0; font-size: 0.9rem; box-sizing: border-box; margin-top: 0.4rem; }
    .settings-input:focus { outline: none; border-color: #DC0000; }
    .settings-field { margin-bottom: 0.9rem; }
    .settings-field label { color: #999; font-size: 0.82rem; }
</style>
{% endblock %}

{% block body %}
<div class="settings-wrap">
    <h1>Настройки</h1>

    {% for label, messages in app.flashes %}
        {% for msg in messages %}
            <div class="flash-{{ label }}" style="margin-bottom:1rem;padding:0.6rem 1rem;border-radius:3px;font-size:0.88rem;background:{% if label=='error' %}#3a1a1a;color:#e57373;border:1px solid #5e2e2e{% else %}#1a3a1a;color:#4caf50;border:1px solid #2e5e2e{% endif %};">{{ msg }}</div>
        {% endfor %}
    {% endfor %}

    <form method="post" action="{{ path('app_settings') }}">
        <input type="hidden" name="action" value="credentials">
        <div class="settings-card">
            <strong>Email и пароль</strong>
            <p>Укажите, чтобы можно было входить не только через Telegram.</p>
            <div class="settings-field">
                <label>Email</label>
                <input type="email" name="email" class="settings-input" value="{{ app.user.email ?? '' }}" placeholder="your@email.com">
            </div>
            <div class="settings-field">
                <label>Новый пароль</label>
                <input type="password" name="password" class="settings-input" placeholder="Оставьте пустым, чтобы не менять">
            </div>
        </div>
        <button type="submit" class="btn-save" style="margin-bottom:1.5rem;">Сохранить</button>
    </form>

    <div class="settings-card">
        <strong>Привязка Telegram</strong>
        <p>Привяжите аккаунт, чтобы получать уведомления лично вам в Telegram.</p>
        <div class="tg-status">
            {% if telegramLinked %}
                <span class="tg-badge linked">✓ Привязан</span>
            {% else %}
                <span class="tg-badge unlinked">Не привязан</span>
                <a href="{{ telegramLinkUrl }}" target="_blank" class="btn-tg">Привязать через Telegram</a>
            {% endif %}
        </div>
    </div>

    <form method="post" action="{{ path('app_settings') }}">
        <div class="settings-card">
            <strong>Уведомления в Telegram</strong>
            <p>Управляет тем, будут ли ваши события отправляться в Telegram.</p>
            <label>
                <input type="checkbox" name="telegram_enabled" value="1" {{ telegramEnabled ? 'checked' : '' }}>
                Отправлять мои события в Telegram
            </label>
        </div>

        <button type="submit" class="btn-save">Сохранить</button>
        <a href="{{ path('app_news') }}" class="back-link">← К новостям</a>
    </form>
</div>
{% endblock %}

{% if app.user %}
<div id="toast-container" style="position:fixed;top:1rem;right:1rem;z-index:9999;display:flex;flex-direction:column;gap:0.5rem;"></div>
<script>
(function () {
    var container = document.getElementById('toast-container');
    var labels = {
        user_registered: 'New user registered',
        user_logged_in: 'User logged in',
        news_imported: 'News imported'
    };

    function showToast(type, payload) {
        var label = labels[type] || type;
        var detail = '';
        if (payload.email) detail = ': ' + payload.email;
        if (payload.count) detail = ': ' + payload.count + ' new items from ' + (payload.source || '');

        var el = document.createElement('div');
        el.style.cssText = 'background:#333;color:#fff;padding:0.6rem 1rem;border-radius:4px;font-size:0.9rem;opacity:1;transition:opacity 0.4s';
        el.textContent = label + detail;
        container.appendChild(el);

        setTimeout(function () {
            el.style.opacity = '0';
            setTimeout(function () { el.remove(); }, 400);
        }, 5000);
    }

    var lastId = 0;
    var es = new EventSource('{{ path('app_stream_notifications') }}?lastId=' + lastId);

    es.onmessage = function (e) {
        var msg = JSON.parse(e.data);
        if (msg.id > lastId) lastId = msg.id;
        showToast(msg.type, msg.payload || {});
    };

    es.onerror = function () {
        es.close();
        setTimeout(function () {
            es = new EventSource('{{ path('app_stream_notifications') }}?lastId=' + lastId);
        }, 3000);
    };
})();
</script>
{% endif %}
